{
  "appId": "com.zorvani.erp",
  "appName": "ZorvanI ERP",
  "webDir": "dist/android",
  "backgroundColor": "#050816",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#050816"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#001532",
      "showSpinner": false
    },
    "SystemBars": {
      "style": "DARK"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
